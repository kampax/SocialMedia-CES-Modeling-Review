Address = {ST ALBAN-ANLAGE 66, CH-4052 BASEL, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Fisher, DM (Corresponding Author), Stanford Univ, Woods Inst Environm, Nat Capital Project, Stanford, CA 94305 USA.
   Fisher, David M.; Wood, Spencer A., Stanford Univ, Woods Inst Environm, Nat Capital Project, Stanford, CA 94305 USA.
   Wood, Spencer A., Univ Washington, Sch Environm \& Forest Sci, Seattle, WA 98195 USA.
   Wood, Spencer A., Univ Washington, eSci Inst, Seattle, WA 98195 USA.
   Roh, Young-Hee, Seoul Natl Univ, Inst Korean Reg Studies, 1 Gwanak Ro, Seoul 08826, South Korea.
   Kim, Choong-Ki, Korea Environm Inst, Div Nat Environm, 370 Sicheong Daero, Sejong Si 30147, South Korea.},
